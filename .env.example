TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=-100...
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
POLL_INTERVAL_SECONDS=300
COLD_START_LOOKBACK_DAYS=30
DATABASE_PATH=./data/bot.db
BOT_ADMIN_USERNAMES=your_telegram_username
TRACKED_ACTIVITY_TYPES=Run,TrailRun,VirtualRun,Hike,Walk
NOTIFICATION_MODE=card_and_text

# AI activity comments — unset AI_API_KEY to disable the feature entirely
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_HISTORY_LIMIT=30
AI_TIMEOUT_SECONDS=20
AI_MAX_CHARS=280
# Upstream generation cap. Keep generous: reasoning models spend this budget on
# hidden reasoning before emitting visible text, and a low value makes them
# return empty content with finish_reason=length.
AI_MAX_TOKENS=1000
# Path to a file holding the system prompt; unset uses the built-in one. Re-read
# on every request, so editing the file changes the bot's voice without a
# restart. Under Docker the path must be inside a mounted volume.
AI_SYSTEM_PROMPT_FILE=
